# =================================================
# 广汽云 ChatBI 生产环境配置示例
# =================================================
# 使用方法：
#   1. 本地开发：cp .env.example .env  (使用本地默认值)
#   2. 生产部署：分别在 Vercel / Koyeb 控制台手动填入这些变量
# =================================================

# ─── LLM 配置（必填） ──────────────────────────────
# DeepSeek API Key，在 https://platform.deepseek.com 申请
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM API Base URL（DeepSeek 官方）
LLM_BASE_URL=https://api.deepseek.com/v1

# ─── 后端 CORS 配置 ────────────────────────────────
# 前端的完整 URL（部署后填入实际地址）
FRONTEND_URL=https://gac-chatbi.vercel.app

# ─── 前端 API 地址 ─────────────────────────────────
# 在 Vercel 部署时填入 Koyeb 给的 URL
NEXT_PUBLIC_API_URL=https://gac-chatbi-api-xxxxx.koyeb.app

# ─── Python 环境 ───────────────────────────────────
PYTHONUNBUFFERED=1
PYTHONPATH=/app

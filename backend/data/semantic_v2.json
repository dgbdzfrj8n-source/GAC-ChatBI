{
  "version": "2.0.0",
  "domain_group": "广汽集团经营分析体系",
  "metrics": [
    {
      "metric_id": "M01",
      "metric_name": "销售达成率",
      "business_domain": "整车销售",
      "definition": "统计周期内实际交付整车数量占同期预算目标交付量的比例。注意：fact_sales_daily 为日/车型粒度，dim_budget_target 为月度粒度，直接 JOIN 会产生 1:N 扇出，计算必须先使用 CTE 对事实表按月聚合再关联。",
      "unit": "%",
      "calculation_rule": "ROUND(s_agg.actual_units * 100.0 / NULLIF(b.target_units, 0), 2)",
      "required_tables": ["fact_sales_daily", "dim_budget_target"],
      "related_dimensions": ["brand_name", "sale_date", "region_name"],
      "notes": "必须先聚合 fact_sales_daily 到月粒度，再与 dim_budget_target JOIN"
    },
    {
      "metric_id": "M02",
      "metric_name": "总交付量",
      "business_domain": "整车销售",
      "definition": "统计周期内最终交付给终端消费者的整车数量合计。",
      "unit": "辆",
      "calculation_rule": "SUM(delivered_units)",
      "required_tables": ["fact_sales_daily"],
      "related_dimensions": ["brand_name", "sale_date", "region_name", "model_name"],
      "notes": ""
    },
    {
      "metric_id": "M03",
      "metric_name": "单车成交均价",
      "business_domain": "整车销售",
      "definition": "整车开票总营收与交付总量的比值，反映产品结构与价格稳定性。",
      "unit": "元/辆",
      "calculation_rule": "ROUND(SUM(gross_revenue) * 1.0 / NULLIF(SUM(delivered_units), 0), 2)",
      "required_tables": ["fact_sales_daily"],
      "related_dimensions": ["brand_name", "model_name", "sale_date"],
      "notes": "除零保护"
    },
    {
      "metric_id": "M04",
      "metric_name": "单车营销费用",
      "business_domain": "经营财务",
      "definition": "统计周期内营销投放总支出与交付总量的比值，衡量市场获客与促销投入的综合产出效率。",
      "unit": "元/辆",
      "calculation_rule": "ROUND(m_agg.total_expense * 1.0 / NULLIF(s_agg.total_units, 0), 2)",
      "required_tables": ["fact_marketing_expenses", "fact_sales_daily"],
      "related_dimensions": ["brand_name", "expense_date"],
      "notes": "两表需分别聚合后再 JOIN 计算比值"
    },
    {
      "metric_id": "M05",
      "metric_name": "单渠道获客成本(CPL)",
      "business_domain": "市场营销",
      "definition": "特定推广渠道投放支出与所带来留资线索总量的比值，评估渠道采买效率。",
      "unit": "元/条",
      "calculation_rule": "ROUND(SUM(expense_amount) * 1.0 / NULLIF(SUM(leads_generated), 0), 2)",
      "required_tables": ["fact_marketing_expenses"],
      "related_dimensions": ["channel_name", "brand_name", "expense_date"],
      "notes": ""
    },
    {
      "metric_id": "M06",
      "metric_name": "渠道ROI",
      "business_domain": "市场营销",
      "definition": "特定推广渠道投放支出与所带来交付总营收的比值，评估渠道最终成交贡献的回报率。",
      "unit": "倍",
      "calculation_rule": "ROUND(s_agg.total_revenue / NULLIF(m_agg.total_spend, 0), 2)",
      "required_tables": ["fact_marketing_expenses", "fact_sales_daily"],
      "related_dimensions": ["channel_name", "brand_name"],
      "notes": "按品牌+月份聚合后两表 JOIN"
    },
    {
      "metric_id": "M07",
      "metric_name": "营销费用率",
      "business_domain": "经营财务",
      "definition": "营销总支出与总营收的比值，衡量营销投入占营收比例。",
      "unit": "%",
      "calculation_rule": "ROUND(m_agg.total_expense * 100.0 / NULLIF(s_agg.total_revenue, 0), 2)",
      "required_tables": ["fact_marketing_expenses", "fact_sales_daily"],
      "related_dimensions": ["brand_name", "expense_date"],
      "notes": ""
    },
    {
      "metric_id": "M08",
      "metric_name": "总营收",
      "business_domain": "经营财务",
      "definition": "统计周期内整车开票总营收。",
      "unit": "万元",
      "calculation_rule": "ROUND(SUM(gross_revenue) / 10000, 2)",
      "required_tables": ["fact_sales_daily"],
      "related_dimensions": ["brand_name", "model_name", "sale_date", "region_name"],
      "notes": ""
    },
    {
      "metric_id": "M09",
      "metric_name": "单车毛利",
      "business_domain": "经营财务",
      "definition": "单车营收减去单车成本（简化：使用 gross_revenue 估算毛利贡献）。",
      "unit": "元/辆",
      "calculation_rule": "ROUND((SUM(gross_revenue) - SUM(cost_estimate)) * 1.0 / NULLIF(SUM(delivered_units), 0), 2)",
      "required_tables": ["fact_sales_daily"],
      "related_dimensions": ["brand_name", "model_name"],
      "notes": "当前数仓无成本字段，使用营收估算"
    },
    {
      "metric_id": "M10",
      "metric_name": "预算目标量",
      "business_domain": "整车销售",
      "definition": "各品牌各月的预算交付目标量。",
      "unit": "辆",
      "calculation_rule": "SUM(target_units)",
      "required_tables": ["dim_budget_target"],
      "related_dimensions": ["brand_name", "year_month"],
      "notes": ""
    },
    {
      "metric_id": "M11",
      "metric_name": "销量同比增速",
      "business_domain": "整车销售",
      "definition": "本期销量与去年同期的增长百分比。",
      "unit": "%",
      "calculation_rule": "ROUND((current_units - last_year_units) * 100.0 / NULLIF(last_year_units, 0), 2)",
      "required_tables": ["fact_sales_daily"],
      "related_dimensions": ["brand_name", "sale_date"],
      "notes": "需要 LAG 函数获取去年同期数据"
    },
    {
      "metric_id": "M12",
      "metric_name": "销量环比增速",
      "business_domain": "整车销售",
      "definition": "本期销量与上期的增长百分比。",
      "unit": "%",
      "calculation_rule": "ROUND((current_units - prev_units) * 100.0 / NULLIF(prev_units, 0), 2)",
      "required_tables": ["fact_sales_daily"],
      "related_dimensions": ["brand_name", "sale_date"],
      "notes": "需要 LAG 函数获取上期数据"
    },
    {
      "metric_id": "M13",
      "metric_name": "车型销量占比",
      "business_domain": "整车销售",
      "definition": "某车型销量占品牌总销量的比例。",
      "unit": "%",
      "calculation_rule": "ROUND(model_units * 100.0 / NULLIF(brand_total_units, 0), 2)",
      "required_tables": ["fact_sales_daily"],
      "related_dimensions": ["brand_name", "model_name"],
      "notes": ""
    },
    {
      "metric_id": "M14",
      "metric_name": "区域销量占比",
      "business_domain": "整车销售",
      "definition": "某区域销量占全国总销量的比例。",
      "unit": "%",
      "calculation_rule": "ROUND(region_units * 100.0 / NULLIF(total_units, 0), 2)",
      "required_tables": ["fact_sales_daily"],
      "related_dimensions": ["region_name", "brand_name"],
      "notes": ""
    },
    {
      "metric_id": "M15",
      "metric_name": "线索总量",
      "business_domain": "市场营销",
      "definition": "各渠道带来的留资线索总数量。",
      "unit": "条",
      "calculation_rule": "SUM(leads_generated)",
      "required_tables": ["fact_marketing_expenses"],
      "related_dimensions": ["channel_name", "brand_name", "expense_date"],
      "notes": ""
    },
    {
      "metric_id": "M16",
      "metric_name": "渠道线索占比",
      "business_domain": "市场营销",
      "definition": "某渠道线索量占总线索量的比例。",
      "unit": "%",
      "calculation_rule": "ROUND(channel_leads * 100.0 / NULLIF(total_leads, 0), 2)",
      "required_tables": ["fact_marketing_expenses"],
      "related_dimensions": ["channel_name", "brand_name"],
      "notes": ""
    },
    {
      "metric_id": "M17",
      "metric_name": "投放金额",
      "business_domain": "市场营销",
      "definition": "各渠道的营销投放总支出。",
      "unit": "万元",
      "calculation_rule": "ROUND(SUM(expense_amount) / 10000, 2)",
      "required_tables": ["fact_marketing_expenses"],
      "related_dimensions": ["channel_name", "brand_name", "expense_date"],
      "notes": ""
    },
    {
      "metric_id": "M18",
      "metric_name": "进店客流",
      "business_domain": "渠道经营",
      "definition": "统计周期内各门店的进店客流人次。",
      "unit": "人次",
      "calculation_rule": "SUM(store_visits)",
      "required_tables": ["fact_dealer_traffic"],
      "related_dimensions": ["brand_name", "region_name", "channel_source", "traffic_date"],
      "notes": "v2.0新增表"
    },
    {
      "metric_id": "M19",
      "metric_name": "留资率",
      "business_domain": "渠道经营",
      "definition": "进店客流中留资的比例。",
      "unit": "%",
      "calculation_rule": "ROUND(SUM(leads_count) * 100.0 / NULLIF(SUM(store_visits), 0), 2)",
      "required_tables": ["fact_dealer_traffic"],
      "related_dimensions": ["brand_name", "region_name", "channel_source"],
      "notes": "v2.0新增表，漏斗第一层转化"
    },
    {
      "metric_id": "M20",
      "metric_name": "试驾率",
      "business_domain": "渠道经营",
      "definition": "留资客户中试驾的比例。",
      "unit": "%",
      "calculation_rule": "ROUND(SUM(test_drives) * 100.0 / NULLIF(SUM(leads_count), 0), 2)",
      "required_tables": ["fact_dealer_traffic"],
      "related_dimensions": ["brand_name", "region_name", "channel_source"],
      "notes": "v2.0新增表，漏斗第二层转化"
    },
    {
      "metric_id": "M21",
      "metric_name": "客流成交转化率",
      "business_domain": "渠道经营",
      "definition": "进店客流中最终成交的比例，衡量终端门店的客流接待与成交转化效率。",
      "unit": "%",
      "calculation_rule": "ROUND(SUM(deals_closed) * 100.0 / NULLIF(SUM(store_visits), 0), 2)",
      "required_tables": ["fact_dealer_traffic"],
      "related_dimensions": ["brand_name", "region_name", "channel_source"],
      "notes": "v2.0新增表"
    },
    {
      "metric_id": "M22",
      "metric_name": "平均停留时长",
      "business_domain": "渠道经营",
      "definition": "客户在门店的平均停留时间。",
      "unit": "分钟",
      "calculation_rule": "ROUND(AVG(avg_dwell_minutes), 1)",
      "required_tables": ["fact_dealer_traffic"],
      "related_dimensions": ["brand_name", "channel_source"],
      "notes": "v2.0新增表，昊铂品牌停留时长通常高于埃安"
    },
    {
      "metric_id": "M23",
      "metric_name": "在库车辆数",
      "business_domain": "库存管理",
      "definition": "各品牌/车型/大区当前的库存车辆数量。",
      "unit": "辆",
      "calculation_rule": "SUM(stock_units)",
      "required_tables": ["fact_inventory"],
      "related_dimensions": ["brand_name", "model_name", "region_name", "snapshot_month"],
      "notes": "v2.0新增表"
    },
    {
      "metric_id": "M24",
      "metric_name": "库存周转天数",
      "business_domain": "库存管理",
      "definition": "当前库存在库天数的平均值，反映库存消化速度。",
      "unit": "天",
      "calculation_rule": "ROUND(AVG(avg_stock_days), 1)",
      "required_tables": ["fact_inventory"],
      "related_dimensions": ["brand_name", "model_name", "region_name"],
      "notes": "v2.0新增表，周转天数越高代表滞销风险越大"
    },
    {
      "metric_id": "M25",
      "metric_name": "库存系数",
      "business_domain": "库存管理",
      "definition": "库存台数与月均销量的比值，>1.5 为预警，>2.0 为严重滞销。",
      "unit": "倍",
      "calculation_rule": "ROUND(AVG(stock_coefficient), 2)",
      "required_tables": ["fact_inventory"],
      "related_dimensions": ["brand_name", "model_name", "region_name"],
      "notes": "v2.0新增表"
    },
    {
      "metric_id": "M26",
      "metric_name": "库龄超90天占比",
      "business_domain": "库存管理",
      "definition": "库龄超过90天的库存车辆占在库总量的比例。",
      "unit": "%",
      "calculation_rule": "ROUND(SUM(aging_over_90d_units) * 100.0 / NULLIF(SUM(stock_units), 0), 2)",
      "required_tables": ["fact_inventory"],
      "related_dimensions": ["brand_name", "model_name"],
      "notes": "v2.0新增表"
    },
    {
      "metric_id": "M27",
      "metric_name": "缺货车型数",
      "business_domain": "库存管理",
      "definition": "当前缺货预警的车型数量（库存系数<0.8）。",
      "unit": "个",
      "calculation_rule": "COUNT(DISTINCT CASE WHEN shortage_flag THEN model_name END)",
      "required_tables": ["fact_inventory"],
      "related_dimensions": ["brand_name", "region_name", "snapshot_month"],
      "notes": "v2.0新增表"
    },
    {
      "metric_id": "M28",
      "metric_name": "渠道成交转化率",
      "business_domain": "渠道经营",
      "definition": "各渠道留资客户的最终成交比例。",
      "unit": "%",
      "calculation_rule": "ROUND(SUM(deals_closed) * 100.0 / NULLIF(SUM(leads_count), 0), 2)",
      "required_tables": ["fact_dealer_traffic"],
      "related_dimensions": ["channel_name", "brand_name"],
      "notes": "v2.0新增表"
    },
    {
      "metric_id": "M29",
      "metric_name": "试驾成交率",
      "business_domain": "渠道经营",
      "definition": "试驾客户中最终成交的比例。",
      "unit": "%",
      "calculation_rule": "ROUND(SUM(deals_closed) * 100.0 / NULLIF(SUM(test_drives), 0), 2)",
      "required_tables": ["fact_dealer_traffic"],
      "related_dimensions": ["brand_name", "region_name"],
      "notes": "v2.0新增表"
    },
    {
      "metric_id": "M30",
      "metric_name": "在途车辆数",
      "business_domain": "库存管理",
      "definition": "在运输途中的车辆数量。",
      "unit": "辆",
      "calculation_rule": "SUM(in_transit_units)",
      "required_tables": ["fact_inventory"],
      "related_dimensions": ["brand_name", "model_name", "region_name", "snapshot_month"],
      "notes": "v2.0新增表"
    }
  ],
  "dimensions": [
    {"id": "D01", "name": "品牌", "field": "brand_name", "table": "fact_sales_daily", "values": ["广汽埃安", "广汽传祺", "昊铂"]},
    {"id": "D02", "name": "车型", "field": "model_name", "table": "fact_sales_daily", "values": ["AION Y", "AION S", "传祺GS8", "传祺M8", "昊铂GT"]},
    {"id": "D03", "name": "大区", "field": "region_name", "table": "fact_sales_daily", "values": ["华南区", "华东区", "华北区", "华中区", "西南区"]},
    {"id": "D04", "name": "月份", "field": "year_month", "table": "dim_budget_target", "values": ["2024-04", "2024-05", "2024-06"]},
    {"id": "D05", "name": "渠道", "field": "channel_name", "table": "fact_marketing_expenses", "values": ["抖音信息流", "懂车帝垂直类", "商圈巡展外拓", "区域广播与电梯屏"]},
    {"id": "D06", "name": "能源类型", "field": "energy_type", "table": "fact_sales_daily", "values": ["纯电", "插混", "燃油"]},
    {"id": "D07", "name": "价格段", "field": "price_segment", "table": "fact_sales_daily", "values": ["10万以下", "10-15万", "15-20万", "20-30万", "30万以上"]},
    {"id": "D08", "name": "客流来源", "field": "channel_source", "table": "fact_dealer_traffic", "values": ["自然到店", "抖音线索", "汽车之家", "懂车帝", "老客转介绍"]},
    {"id": "D09", "name": "门店", "field": "dealer_name", "table": "fact_dealer_traffic", "values": []},
    {"id": "D10", "name": "快照月份", "field": "snapshot_month", "table": "fact_inventory", "values": []}
  ],
  "synonyms": [
    {"keyword": "销量", "field": "delivered_units", "metrics": ["M02", "M11", "M12"]},
    {"keyword": "交付", "field": "delivered_units", "metrics": ["M02"]},
    {"keyword": "达成率", "field": "fulfillment_rate", "metrics": ["M01"]},
    {"keyword": "营收", "field": "gross_revenue", "metrics": ["M08"]},
    {"keyword": "CPL", "field": "cpl", "metrics": ["M05"]},
    {"keyword": "获客成本", "field": "cpl", "metrics": ["M05"]},
    {"keyword": "ROI", "field": "roi", "metrics": ["M06"]},
    {"keyword": "客流", "field": "store_visits", "metrics": ["M18", "M21"]},
    {"keyword": "转化率", "field": "conversion_rate", "metrics": ["M19", "M20", "M21", "M28", "M29"]},
    {"keyword": "库存", "field": "stock_units", "metrics": ["M23", "M24", "M25"]},
    {"keyword": "线索", "field": "leads_generated", "metrics": ["M15", "M16"]}
  ]
}

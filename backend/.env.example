# ==================================================
# 广汽云 ChatBI - 后端环境变量模板
# 复制此文件为 .env，并填入实际值
# ==================================================

# 服务端口（Render 自动注入 PORT=10000）
PORT=8000

# CORS 白名单（多个域名用逗号分隔）
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 是否启用 Mock 模式（生产应设为 false）
FORCE_MOCK=false

# 生产日志级别
LOG_LEVEL=info

# 数据底座路径（容器内使用绝对路径）
DUCKDB_PATH=/app/data/gac_bi.duckdb
